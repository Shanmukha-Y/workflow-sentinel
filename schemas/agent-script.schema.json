{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scripted advisory response sequence",
  "type": "array",
  "minItems": 1,
  "maxItems": 8,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "action": {
            "const": "abstain"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "evidence",
              "propose",
              "validate",
              "finish"
            ]
          },
          "packet": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "action",
          "packet"
        ],
        "additionalProperties": false
      }
    ]
  }
}
