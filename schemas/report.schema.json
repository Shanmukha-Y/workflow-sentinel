{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "mode": {
      "const": "offline-deterministic"
    },
    "packets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "review",
              "abstain"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "excerpt": {
                  "type": "string",
                  "maxLength": 500
                },
                "column": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_column": {
                  "type": "integer",
                  "minimum": 1
                },
                "yaml_path": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                },
                "provenance": {
                  "enum": [
                    "hash-matched",
                    "snippet-matched",
                    "unverified"
                  ]
                },
                "citation": {
                  "type": "string"
                },
                "context": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "job",
                    "step_index",
                    "triggers",
                    "permissions",
                    "job_if",
                    "step_if",
                    "shell",
                    "run_expressions",
                    "env_expressions",
                    "checkouts",
                    "citations"
                  ],
                  "properties": {
                    "job": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "step_index": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "triggers": {
                      "type": "array",
                      "maxItems": 30,
                      "items": {
                        "type": "string"
                      }
                    },
                    "permissions": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source",
                        "declaration"
                      ],
                      "properties": {
                        "source": {
                          "enum": [
                            "job",
                            "workflow",
                            "repository-default"
                          ]
                        },
                        "declaration": {
                          "oneOf": [
                            {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string"
                              }
                            }
                          ]
                        }
                      }
                    },
                    "job_if": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "step_if": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "shell": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "run_expressions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "env_expressions": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "checkouts": {
                      "type": "array",
                      "maxItems": 40,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "job",
                          "step_index",
                          "uses",
                          "ref",
                          "repository",
                          "citation"
                        ],
                        "properties": {
                          "job": {
                            "type": "string"
                          },
                          "step_index": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "uses": {
                            "type": "string"
                          },
                          "ref": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "repository": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "citation": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "column_kind": {
                  "const": "unicodeCodePoints"
                }
              },
              "required": [
                "path",
                "line",
                "sha256",
                "excerpt",
                "column",
                "end_line",
                "end_column",
                "yaml_path",
                "provenance",
                "citation",
                "context",
                "column_kind"
              ]
            }
          },
          "guidance": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "trace": {
            "type": "array",
            "maxItems": 80,
            "items": {
              "type": "string",
              "maxLength": 600
            }
          },
          "repair": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reason",
              "unified_diff",
              "path",
              "base_sha256",
              "proposed_sha256",
              "validation"
            ],
            "properties": {
              "status": {
                "enum": [
                  "proposed",
                  "abstain"
                ]
              },
              "reason": {
                "type": "string"
              },
              "unified_diff": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 16000
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "base_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "proposed_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "validation": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "proposed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "base_sha256": {
                      "type": "string",
                      "minLength": 1
                    },
                    "proposed_sha256": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unified_diff": {
                      "type": "string",
                      "minLength": 1
                    },
                    "validation": {
                      "minItems": 4
                    }
                  }
                },
                "else": {
                  "properties": {
                    "path": {
                      "type": "null"
                    },
                    "base_sha256": {
                      "type": "null"
                    },
                    "proposed_sha256": {
                      "type": "null"
                    },
                    "unified_diff": {
                      "type": "null"
                    },
                    "validation": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          },
          "static_validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reason",
              "scope",
              "scanner_version",
              "attempts",
              "before_findings",
              "after_findings",
              "new_findings",
              "target_removed",
              "checks"
            ],
            "properties": {
              "status": {
                "enum": [
                  "validated",
                  "rejected",
                  "unsupported",
                  "unavailable"
                ]
              },
              "reason": {
                "type": "string"
              },
              "scope": {
                "const": "single-workflow"
              },
              "scanner_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "before_findings": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "after_findings": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "new_findings": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "target_removed": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "checks": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "rule_id",
          "decision",
          "evidence",
          "guidance",
          "citations",
          "reason",
          "trace"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "review"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "evidence": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "mode",
    "packets",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
