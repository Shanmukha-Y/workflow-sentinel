{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mode": {
      "const": "offline-deterministic"
    },
    "packets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "review",
              "abstain"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "excerpt": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "path",
                "line",
                "sha256",
                "excerpt"
              ]
            }
          },
          "guidance": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "decision",
          "evidence",
          "guidance",
          "citations",
          "reason"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "review"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "evidence": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "mode",
    "packets",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
